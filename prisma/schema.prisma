// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A need posted by a department (IdentifyModule)
model Need {
  id          String   @id @default(uuid())
  dept        String
  title       String
  description String
  budget      String
  domain      String
  postedAt    DateTime @default(now())
  status      String   @default("Open") // Open | Matching | Closed

  @@map("needs")
}

// A pilot card on the tracker board (PilotModule)
// status moves through: Applied -> Piloting -> Scaling -> Completed
model PilotCard {
  id        String   @id @default(uuid())
  startup   String
  dept      String
  title     String
  budget    String
  progress  Int      @default(0)
  date      String
  status           String   @default("Applied")
  accent           String   @default("text-sky-400")
  needId           String?
  scaledContractId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([startup, needId], name: "startup_need_unique")
  @@map("pilot_cards")
}

// Created automatically when a pilot graduates to "Completed" —
// this is the real, queryable record of a scaled procurement contract.
model ScaledContract {
  id             String   @id @default(uuid())
  startup        String
  dept           String
  title          String
  pilotBudget    String
  scaledBudget   String
  pilotStartDate String
  contractDate   DateTime @default(now())

  @@map("scaled_contracts")
}
